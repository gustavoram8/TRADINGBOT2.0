# Proveedor de IA: "gemini" (gratis), "openai" o "anthropic"
AI_PROVIDER=gemini

# --- Gemini (Google AI Studio) — GRATIS, recomendado para empezar ---
# Conseguí la key en https://aistudio.google.com  ->  "Get API Key"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Si usás OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Si usás Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Puerto del servidor local
PORT=8000
