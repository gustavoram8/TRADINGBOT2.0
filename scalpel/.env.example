# Copy this file to .env and fill in your values
# cp .env.example .env

# Your GitHub Models token (github.com > Settings > Developer settings > Personal access tokens)
GITHUB_TOKEN=your_github_token_here

# Claude model to use via GitHub Models
# Options: claude-3-5-sonnet, claude-3-7-sonnet
SCALPEL_MODEL=claude-3-5-sonnet

# Port (optional, defaults to 5001)
PORT=5001
