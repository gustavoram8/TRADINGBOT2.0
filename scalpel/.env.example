# Copy this file to .env and fill in your values
# cp .env.example .env

# ── AI (GitHub Models) ──
# Your GitHub Models token (github.com > Settings > Developer settings > Personal access tokens)
GITHUB_TOKEN=your_github_token_here
# Vision model used via GitHub Models
SCALPEL_MODEL=gpt-4o

# ── Server ──
PORT=5001

# ── Security ──
# Stable signing key for sessions + password-reset tokens.
# If left unset, the app auto-generates one and saves it to scalpel/.secret_key
# SECRET_KEY=generate_a_long_random_string

# ── Admin account (seeded on first run) ──
ADMIN_USERNAME=admin
ADMIN_EMAIL=mauroramirezmij@gmail.com
ADMIN_PASSWORD=change_me_after_first_login

# ── Email / password recovery (Gmail SMTP) ──
# MAIL_APP_PASSWORD is a 16-char Google "App Password" (NOT your normal Gmail password).
# Generate at: myaccount.google.com/apppasswords
MAIL_USERNAME=mauroramirezmij@gmail.com
MAIL_APP_PASSWORD=your_16_char_google_app_password
