# Proveedor de IA: "github" (gratis), "gemini", "openai" o "anthropic"
AI_PROVIDER=github

# --- GitHub Models — GRATIS, recomendado para empezar ---
# Conseguí el token en github.com -> Settings -> Developer settings -> Personal access tokens
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Si usás OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Si usás Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Puerto del servidor local
PORT=8000
